    "from sklearn.linear_model import LassoCV, LinearRegression\n",
    "from sklearn.feature_selection import SelectFromModel\n",
    "from sklearn.pipeline import Pipeline\n",
    "\n",
    "from regpath import (\n",
    "    LassoPath,\n",
    "    plot_lasso_path,\n",
    ")\n",
    "\n",
    "# create pipeline => preprocess + lasso + linear regression (on the features selected by lasso)\n",
    "preprocess = dataset.get_preprocess()\n",
    "cv = list(GroupKFold(n_splits=5).split(X, y, groups))\n",
    "pipeline = Pipeline(\n",
    "    [\n",
    "        (\"preprocess\", preprocess),\n",
    "        (\n",
    "            \"selection\",\n",
    "            SelectFromModel(LassoCV(cv=cv, random_state=RANDOM_STATE)),\n",
    "        ),\n",
    "        (\"regression\", LinearRegression()),\n",
    "    ]\n",
    ")\n",
    "pipeline.fit(X, y)"
   ]
  },
