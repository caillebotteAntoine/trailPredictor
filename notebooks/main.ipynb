    "from sklearn.model_selection import GroupKFold\n",
    "\n",
    "# models = make_models()\n",
    "# pred = cross_val_predict(models[\"linear\"], X, y, groups=groups)\n",
    "pred = pipeline.predict(X)\n",
    "\n",
    "plt.figure(figsize=(12, 6))\n",
    "plt.plot(pred)\n",
    "plt.plot(dataset.target, alpha=0.5)\n",
    "\n",
    "dataset.prediction = pred\n",
    "\n",
    "results = pd.concat(\n",
    "    [\n",
    "        dataset.true_total_time,\n",
    "        dataset.predict_total_time(),\n",
    "        # dataset.error_total_time(),\n",
    "    ],\n",
    "    axis=1,\n",
    ")\n",
    "\n",
    "# absolute error in minutes\n",
    "results[\"error_total_time\"] = np.abs(\n",
    "    results[\"predict_total_time\"] - results[\"true_total_time\"]\n",
    ")\n",
    "results"
   ]
